//&route_dsi0 {
//	status = "okay";
//	connect = <&vp1_out_dsi0>;
//};

&sdmmc1 {
    max-frequency = <50000000>;
    supports-sdio;
    bus-width = <4>;
    disable-wp;
    cap-sd-highspeed;
    cap-sdio-irq;
    keep-power-in-suspend;
    mmc-pwrseq = <&sdio_pwrseq>;
    non-removable;
    pinctrl-names = "default";
    pinctrl-0 = <&sdmmc1_bus4 &sdmmc1_cmd &sdmmc1_clk>;
    sd-uhs-sdr104;
    status = "okay";

};

&uart1 {
	status = "okay";
	pinctrl-names = "default";
         pinctrl-0 = <&uart1m0_xfer &uart1m0_ctsn>;
};

