#include "rk3566.dtsi"
#include "rk3566-evb.dtsi"

/ {
	model = "Rockchip RK3566 EVB1 DDR4 V10 Board";
	compatible = "rockchip,rk3566-evb1-ddr4-v10", "rockchip,rk3566";
